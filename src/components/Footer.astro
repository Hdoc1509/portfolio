---
import Icon from "./Icon.astro";
---

<footer>
  <p>
    Developed by &lt;Hdoc /&gt; using <a href="https://astro.build/">Astro</a>
    <Icon icon="rocket-launch" size="1.2em" />
  </p>
  <p class="socials">
    <a href="https://www.linkedin.com/in/hdocdev">LinkedIn</a>
    <a href="https://github.com/Hdoc1509">GitHub</a>
  </p>
</footer>
<style>
  footer {
    display: grid;
    max-width: 83rem;
    gap: 2rem;
    margin-inline: auto;
    padding: 3rem 2rem 3rem;
    text-align: center;
    color: var(--gray-400);
    font-size: var(--text-sm);
  }

  footer a {
    color: var(--gray-400);
    text-decoration: 1px solid underline transparent;
    text-underline-offset: 0.25em;
    transition: text-decoration-color var(--theme-transition);
  }

  footer a:hover,
  footer a:focus {
    text-decoration-color: currentColor;
  }

  .socials {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (min-width: 50em) {
    footer {
      grid-template-columns: 1fr 1fr;
      gap: 6rem;
      padding: 2.5rem 5rem;
    }
  }
</style>
