---
import Icon from "./Icon.astro";
import Pill from "./Pill.astro";
import type { ProjectEntry } from "../consts";

type Props = {
  project: ProjectEntry;
};

const { title, url, image, imageAlt, description, tools, repoUrl } =
  Astro.props.project;
---

<div class="card">
  <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
  <header>
    <h4>{title}</h4>
    <nav>
      <a
        aria-label="Go to live website"
        href={url}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon icon="arrow-square-out" size="1.2em" />
      </a>
      <a
        aria-label="GitHub repository"
        href={repoUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon icon="github-logo" size="1.2em" />
      </a>
    </nav>
  </header>
  <p class="description">{description}</p>
  <ul class="tools" aria-label="Used tools">
    {
      tools.map((tool) => (
        <li>
          <Pill>{tool}</Pill>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block-end: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: var(--font-brand);
  }
  .card > *:not(img) {
    padding-inline: 1rem;
  }

  header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  header > * {
    font-weight: 500;
    font-size: var(--text-xl);
  }
  header a {
    text-decoration: none;
    color: currentcolor;
  }
  header a:hover,
  header a:focus {
    color: var(--accent-dark);
  }

  img {
    aspect-ratio: 1200 / 630; /* recommended for OpenGraph images */
    object-fit: cover;
    object-position: top;
  }

  .description {
    color: var(--gray-200);
    font-size: var(--text-md);
  }

  .tools {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    color: var(--gray-300);
    font-size: var(--text-sm);
    list-style: none;
  }

  @media (min-width: 50em) {
    .card {
      border-radius: 1.5rem;
    }
  }
</style>
