---
import Icon from "./Icon.astro";
import Pill from "./Pill.astro";
import type { ProjectEntry } from "../consts";

type Props = {
  project: ProjectEntry;
};

const { title, url, image, imageAlt, description, tools, repoUrl } =
  Astro.props.project;
---

<div class="card">
  <img src={image} alt={imageAlt} loading="lazy" decoding="async" />
  <h4 class="title">
    <a href={url} target="_blank">
      {title}
      <Icon icon="arrow-square-out" size="1.2em" />
    </a>
    <a href={repoUrl} target="_blank">
      <Icon icon="github-logo" size="1.2em" />
    </a>
  </h4>
  <p class="description">{description}</p>
  <div class="tools" aria-label="Used tools">
    {tools.map((tool) => <Pill>{tool}</Pill>)}
  </div>
</div>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: 32rem;
    padding-block-end: 1rem;
    border: 1px solid var(--gray-800);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: var(--font-brand);
  }

  .title {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    padding-inline: 1rem;
    font-weight: 500;
    font-size: var(--text-xl);
  }
  .title a {
    text-decoration: none;
    color: currentcolor;
  }
  .title a:hover,
  .title a:focus {
    color: var(--accent-dark);
    text-decoration: underline;
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .description {
    padding-inline: 1rem;
    color: var(--gray-200);
    font-size: var(--text-md);
  }

  .tools {
    display: flex;
    gap: 1rem;
    padding-inline: 1rem;
    color: var(--gray-300);
    font-size: var(--text-sm);
  }

  @media (min-width: 50em) {
    .card {
      border-radius: 1.5rem;
    }
  }
  @media (min-width: 70em) {
    .card {
      height: 36rem;
    }
  }
</style>
